<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF0A1F1A" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🎨 رنگ ویجت‌ها" android:textColor="#FFFFFFFF"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="رنگ دلخواه رو برای هر ویجت انتخاب کن"
            android:textColor="#FF8FA89F" android:textSize="13sp" android:layout_marginTop="4dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📝 ویجت یادداشت‌ها" android:textColor="#FFFFFFFF"
            android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="20dp" />
        <GridLayout android:id="@+id/note_colors_grid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:columnCount="4"
            android:layout_marginTop="10dp" android:rowCount="2" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✅ ویجت وظایف" android:textColor="#FFFFFFFF"
            android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="24dp" />
        <GridLayout android:id="@+id/task_colors_grid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:columnCount="4"
            android:layout_marginTop="10dp" android:rowCount="2" />

        <Button android:id="@+id/btn_done" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="بستن ✨"
            android:layout_marginTop="30dp" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
