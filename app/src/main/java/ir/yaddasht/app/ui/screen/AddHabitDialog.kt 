@Composable
fun AddHabitDialog(
    initial: Habit?,
    onDismiss: () -> Unit,
    onSave: (Habit) -> Unit
) {
    val initialBase = HabitSchedule.basePattern(initial?.pattern ?: "DAILY")
    val initialReminderMin = HabitSchedule.reminderMinutes(initial?.pattern ?: "")

    var title by remember { mutableStateOf(initial?.title ?: "") }
    var emoji by remember { mutableStateOf(initial?.emoji ?: "✅") }
    var colorIndex by remember { mutableIntStateOf(initial?.colorIndex ?: 0) }
    var kind by remember { mutableStateOf(initial?.kind ?: "BINARY") }
    var target by remember { mutableIntStateOf(initial?.targetPerDay ?: 1) }
    var unit by remember { mutableStateOf(initial?.unit ?: "بار") }
    var pattern by remember { mutableStateOf(initialBase) }
    var mask by remember { mutableIntStateOf(initial?.weekdaysMask ?: 0) }
    var everyN by remember { mutableIntStateOf(initial?.everyNDays ?: 1) }
    var cue by remember { mutableStateOf(initial?.cueText ?: "") }
    var reward by remember { mutableStateOf(initial?.rewardText ?: "") }
    val createdAt by remember { mutableLongStateOf(initial?.createdAt ?: System.currentTimeMillis()) }

    var reminderEnabled by remember { mutableStateOf(initialReminderMin != null) }
    var remindHour by remember { mutableIntStateOf(initialReminderMin?.let { it / 60 } ?: 21) }
    var remindMinute by remember { mutableIntStateOf(initialReminderMin?.let { it % 60 } ?: 0) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = {
            Text(
                if (initial == null) "🌱 عادت جدید" else "✏️ ویرایش عادت",
                fontFamily = LalezarFont,
                fontSize = 20.sp
            )
        },
        text = {
            Column(
                Modifier.verticalScroll(rememberScrollState()),
                verticalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                Text("قالب آماده", fontSize = 12.sp, color = MutedGreenText, fontWeight = FontWeight.Bold)
                Row(
                    Modifier.horizontalScroll(rememberScrollState()),
                    horizontalArrangement = Arrangement.spacedBy(6.dp)
                ) {
                    HabitTemplates.forEach { t ->
                        SmallChip("${t.emoji} ${t.name}", false) {
                            title = t.name
                            emoji = t.emoji
                            kind = t.kind
                            target = t.target
                            unit = t.unit
                            pattern = t.basePattern
                            mask = t.weekdaysMask
                            everyN = t.everyNDays
                            cue = t.cue
                            reward = t.reward
                            colorIndex = t.colorIndex
                            if (t.remindHour >= 0) {
                                reminderEnabled = true
                                remindHour = t.remindHour
                                remindMinute = t.remindMinute
                            } else {
                                reminderEnabled = false
                            }
