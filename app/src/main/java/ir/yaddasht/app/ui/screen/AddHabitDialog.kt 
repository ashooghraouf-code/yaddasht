                        ) {
                            Text(e, fontSize = 16.sp)
                        }
                    }
                }

                Text("رنگ", fontSize = 12.sp, color = MutedGreenText, fontWeight = FontWeight.Bold)
                Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
