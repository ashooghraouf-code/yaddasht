<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_note"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📝 یادداشت‌ها"
            android:textColor="#3E2723" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/note_refresh" android:layout_width="32dp" android:layout_height="32dp"
            android:text="⟳" android:textColor="#FFFFFF" android:textSize="18sp"
            android:background="@drawable/widget_btn" android:gravity="center"
            android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/note_add" android:layout_width="32dp" android:layout_height="32dp"
            android:text="+" android:textColor="#FFFFFF" android:textSize="22sp"
            android:textStyle="bold" android:background="@drawable/widget_btn"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout android:id="@+id/note_item_1" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/note_title_1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#3E2723"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" android:text="یادداشتی نیست" />
        <TextView android:id="@+id/note_body_1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#6D4C41"
            android:textSize="11sp" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/note_item_2" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="4dp">
        <TextView android:id="@+id/note_title_2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#3E2723"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" />
        <TextView android:id="@+id/note_body_2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#6D4C41"
            android:textSize="11sp" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/note_item_3" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="4dp">
        <TextView android:id="@+id/note_title_3" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#3E2723"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" />
        <TextView android:id="@+id/note_body_3" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#6D4C41"
            android:textSize="11sp" android:maxLines="2" android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
