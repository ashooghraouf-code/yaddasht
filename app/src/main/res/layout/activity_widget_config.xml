<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FF06100E">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎨 تنظیمات ویجت"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="رنگ دلخواه را انتخاب کنید"
        android:textColor="#FFB0BEC5"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📝 رنگ ویجت یادداشت‌ها"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:id="@+id/config_note_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ رنگ ویجت وظایف / خبرنگاری"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:id="@+id/config_task_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/config_confirm_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ ساخت ویجت با این رنگ"
        android:textColor="#FF06100E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFB74D" />
</LinearLayout>
