<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/note_item_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/widget_item_card" android:padding="10dp">
    <TextView android:id="@+id/note_item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#3E2723" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/note_item_snippet" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#6D4C41" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/note_item_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#8D6E63" android:textSize="9sp" android:layout_marginTop="2dp" />
</LinearLayout>
