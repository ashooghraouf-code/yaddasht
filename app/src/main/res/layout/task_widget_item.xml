<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_item_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/widget_item_card" android:padding="10dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/task_item_check" android:layout_width="28dp" android:layout_height="28dp"
        android:src="@android:drawable/checkbox_off_background" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="6dp">
        <TextView android:id="@+id/task_item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#00393F" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/task_item_due" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#00695C" android:textSize="10sp" android:layout_marginTop="2dp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/task_item_priority" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:layout_marginStart="4dp" />
</LinearLayout>
