<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF80DEEA"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/task_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✅ وظایف من"
            android:textColor="#FF004D40"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="⟳"
            android:textColor="#FF004D40"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/task_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="+"
            android:textColor="#FF004D40"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:background="#40000000" android:padding="6dp" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/task_check_1" android:layout_width="24dp" android:layout_height="24dp" android:text="☐" android:textColor="#FF004D40" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF004D40" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:text="وظیفه‌ای نیست" />
            <TextView android:id="@+id/task_due_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF00796B" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginStart="2dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:background="#40000000" android:padding="6dp" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/task_check_2" android:layout_width="24dp" android:layout_height="24dp" android:text="☐" android:textColor="#FF004D40" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF004D40" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/task_due_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF00796B" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginStart="2dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:background="#40000000" android:padding="6dp" android:gravity="center_vertical">
        <TextView android:id="@+id/task_check_3" android:layout_width="24dp" android:layout_height="24dp" android:text="☐" android:textColor="#FF004D40" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF004D40" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/task_due_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF00796B" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginStart="2dp" />
    </LinearLayout>
</LinearLayout>
