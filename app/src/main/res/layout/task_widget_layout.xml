<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF80DEEA"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/task_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✅ وظایف امروز"
            android:textColor="#FF00363A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/task_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="⟳"
            android:textColor="#FF00363A"
            android:textSize="18sp"
            android:gravity="center" />
        <TextView
            android:id="@+id/task_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="+"
            android:textColor="#FF00363A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_item_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#30000000"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:id="@+id/task_check_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="☐"
            android:textColor="#FF00363A"
            android:textSize="18sp"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:id="@+id/task_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF00363A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/task_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF00695C"
                    android:textSize="9sp"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/task_priority_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="●"
                    android:textColor="#FFBDBDBD"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_item_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#30000000"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">
        <TextView
            android:id="@+id/task_check_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="☐"
            android:textColor="#FF00363A"
            android:textSize="18sp"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:id="@+id/task_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF00363A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/task_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF00695C"
                    android:textSize="9sp"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/task_priority_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="●"
                    android:textColor="#FFBDBDBD"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_item_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#30000000"
        android:padding="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/task_check_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="☐"
            android:textColor="#FF00363A"
            android:textSize="18sp"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:id="@+id/task_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF00363A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/task_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF00695C"
                    android:textSize="9sp"
                    android:maxLines="1" />
                <TextView
                    android:id="@+id/task_priority_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="●"
                    android:textColor="#FFBDBDBD"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
