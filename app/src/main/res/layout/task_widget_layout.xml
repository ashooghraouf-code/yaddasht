<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg_task"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="✅ وظایف من"
            android:textColor="#004D40" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/task_refresh" android:layout_width="32dp" android:layout_height="32dp"
            android:text="⟳" android:textColor="#FFFFFF" android:textSize="18sp"
            android:background="@drawable/widget_btn" android:gravity="center"
            android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/task_add" android:layout_width="32dp" android:layout_height="32dp"
            android:text="+" android:textColor="#FFFFFF" android:textSize="22sp"
            android:textStyle="bold" android:background="@drawable/widget_btn"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_1" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:id="@+id/task_check_1" android:layout_width="28dp" android:layout_height="28dp"
            android:text="☐" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#004D40"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" android:text="وظیفه‌ای نیست" />
            <TextView android:id="@+id/task_due_1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#00796B"
                android:textSize="10sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_2" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/task_check_2" android:layout_width="28dp" android:layout_height="28dp"
            android:text="☐" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#004D40"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" />
            <TextView android:id="@+id/task_due_2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#00796B"
                android:textSize="10sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/task_item_3" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"
        android:background="@drawable/widget_item_card" android:padding="10dp"
        android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/task_check_3" android:layout_width="28dp" android:layout_height="28dp"
            android:text="☐" android:textSize="18sp" android:gravity="center" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/task_title_3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#004D40"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" />
            <TextView android:id="@+id/task_due_3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#00796B"
                android:textSize="10sp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/task_priority_3" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
